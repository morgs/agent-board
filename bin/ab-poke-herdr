#!/bin/sh
# agent-board poke command: <pid> <name> <socket>. Finds the herdr pane the pid runs
# in and prompts the agent there to read its inbox. Set it per machine in
# machines.local:  [local]  poke = ~/agent-board/bin/ab-poke-herdr
#
# The relay runs under launchd or systemd, which do not read a shell profile, so
# herdr is looked for in the usual install places as well as on PATH.
pid=$1
[ -n "$pid" ] || exit 1

# A Codex app-server daemon hosts several sessions under one pid, and its environment
# names the pane that started it, not the session's own pane. A poke there would
# wake the wrong agent, so a daemon pid has no pane. The daemon is the app-server
# subcommand: the first argument that is neither an option nor the value of one, so
# `codex -c k=v app-server` is the daemon and `codex --cd app-server` is not.
proc=${AGENT_BOARD_PROC:-/proc}
if [ -r "$proc/$pid/cmdline" ]; then
  args=$(tr "\0" "\n" < "$proc/$pid/cmdline" 2>/dev/null)
else
  # macOS has no /proc, and `ps` joins the arguments with spaces, so a value with a
  # space in it (-C '/tmp/Agent Board') cannot be told from the next argument. A
  # word that is exactly app-server anywhere is then taken for the daemon: a missed
  # poke is safer than a wake in the wrong pane.
  args=$(ps -o args= -p "$pid" 2>/dev/null | tr ' ' '\n')
  printf '%s\n' "$args" | grep -qx app-server && exit 1
fi
sub=$(printf '%s\n' "$args" | awk '
  # the codex options that take a value
  BEGIN { split("-c --config --enable --disable --remote --remote-auth-token-env -i --image -m --model --local-provider -p --profile -s --sandbox -C --cd --add-dir -a --ask-for-approval", o, " ")
          for (k in o) val[o[k]] = 1 }
  NR == 1 { next }
  skip { skip = 0; next }
  $0 == "--" { exit }
  /^-/ { if (($0 in val) && index($0, "=") == 0) skip = 1; next }
  { print; exit }')
[ "$sub" = app-server ] && exit 1

if [ -r "$proc/$pid/environ" ]; then
  pane=$(tr "\0" "\n" < "$proc/$pid/environ" 2>/dev/null | sed -n "s/^HERDR_PANE_ID=//p")
else
  # macOS has no /proc; `ps eww` appends the environment of a process of this user.
  pane=$(ps eww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n' | sed -n "s/^HERDR_PANE_ID=//p" | head -1)
fi
[ -n "$pane" ] || exit 1

herdr=$(command -v herdr 2>/dev/null)
for c in "$HOME/.local/bin/herdr" /opt/homebrew/bin/herdr /usr/local/bin/herdr "$HOME/.cargo/bin/herdr"; do
  [ -n "$herdr" ] && break
  [ -x "$c" ] && herdr=$c
done
[ -n "$herdr" ] || exit 1

# Nothing is sent unless herdr says what the pane is and what it is doing, and the
# screen shows its input box: a poke presses Enter on whatever is in that box. When
# herdr cannot be read now, exit 75 (EX_TEMPFAIL) and the board tries again on a
# later tick, until the target is idle or has read its mail.
info=$("$herdr" agent get "$pane" 2>/dev/null) || exit 75
status=$(printf '%s' "$info" | sed -n 's/.*"agent_status":"\([a-z_]*\)".*/\1/p')
agent=$(printf '%s' "$info" | grep -o '"agent":"[a-z]*"' | head -n 1 | sed 's/.*:"\(.*\)"/\1/')

# A working agent collects its mail at its own Stop, and a prompt would type into its
# turn; a blocked one has a dialog open. Only idle or done takes a prompt.
case "$status" in
  idle|done) ;;
  *) exit 75 ;;
esac

# A poke presses Enter on whatever is in the input box, so it goes only to a pane
# whose box is, byte for byte, the empty box this agent draws; only the free text
# in it may vary (a placeholder, a session name, the footer's model and path).
# Anything else - a draft, a dialog, a cursor, another style or reset, a version
# that draws its box another way - is 75, and the board tries again later.
#   Claude  a rule (its colour follows the permission mode, and the session
#           name may sit in it, plain or on a label colour), the row "❯" and a no-break space alone or with
#           a dim suggestion, a rule. A draft cannot reach the rows below the box.
#   Codex   the last rows on screen: a blank row on the box colour, the › row
#           with the dim placeholder, a blank row, the status row, the
#           shortcuts row. Codex has no rule under its box, so the footer is
#           matched too.
case "$agent" in
  claude|codex) ;;
  *) exit 1 ;;
esac
screen=$("$herdr" agent read "$pane" --source visible --format ansi 2>/dev/null) || exit 75
printf '%s\n' "$screen" | LC_ALL=C awk -v agent="$agent" '
  BEGIN {
    E = "\033[[]"                               # the start of a style: ESC [
    T = "[^\033]"                               # one character that is not a style
    R = "\342\224\200"                          # ─
    dot = "\302\267"                             # ·
    rgb = E "38;2;[0-9]+;[0-9]+;[0-9]+m"
    rule = "^" E "0m" rgb
    rule_top = rule "(" R ")+(( " T "* " R ")?|" E "0m" rgb E "48;2;[0-9]+;[0-9]+;[0-9]+m " T "* " E "0m" rgb R ")" E "0m$"
    rule_bot = rule "(" R ")+" E "0m$"
    prompt_c = "^\342\235\257\302\240(" E "0m(" E "2m" T "*" E "0m)?)?$"
    bg = E "48;2;52;52;52m"
    pad = "^" E "0m" bg " +" E "0m$"
    prompt_x = "^" E "0m" E "1m" bg "\342\200\272" E "0m" bg " " E "0m" E "2m" bg T "*" E "0m" bg " +" E "0m$"
    sep = E "38;2;118;131;140m " dot " " E "0m"
    status = "^  " E "0m" E "38;2;246;226;183m" T "+" E "0m(" sep rgb T "+" E "0m)+$"
    keys = "^  " E "0m" E "1m" E "38;2;179;201;215m\342\206\220" E "0m" E "38;2;118;131;140m for agents " dot " " E "0m" E "1m" E "38;2;179;201;215m[?]" E "0m" E "38;2;118;131;140m for shortcuts(" E "0m)?( +.*)?$"
  }
  { sub(/\r$/, ""); l[NR] = $0 }
  END {
    if (agent == "claude") {
      for (n = NR; n >= 3; n--) if (l[n] ~ rule_bot) break
      if (n < 3) exit 3
      exit !(l[n - 1] ~ prompt_c && l[n - 2] ~ rule_top)
    }
    for (n = NR; n >= 1 && l[n] == ""; n--) ;
    if (n < 5) exit 3
    exit !(l[n] ~ keys && l[n - 1] ~ status && l[n - 2] ~ pad && l[n - 3] ~ prompt_x && l[n - 4] ~ pad)
  }' || exit 75

exec "$herdr" agent prompt "$pane" "you have mail, run agentboard inbox" >/dev/null
