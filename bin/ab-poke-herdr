#!/bin/sh
# agent-board poke command: <pid> <name> <socket>. Finds the herdr pane the pid runs
# in and prompts the agent there to read its inbox. Set it per machine in
# machines.local:  [local]  poke = ~/agent-board/bin/ab-poke-herdr
#
# The relay runs under launchd or systemd, which do not read a shell profile, so
# herdr is looked for in the usual install places as well as on PATH.
pid=$1
[ -n "$pid" ] || exit 1

# A Codex app-server daemon hosts several sessions under one pid, and its environment
# names the pane that started it, not the session's own pane. A poke there would
# wake the wrong agent, so a daemon pid has no pane. The daemon is the app-server
# subcommand, which global options (-c key=value, --cd dir) may come before, so any
# argument that is exactly app-server counts. A path that only contains the word
# (--cd /work/app-server-ui) is a normal Codex.
if [ -r /proc/"$pid"/cmdline ]; then
  args=$(tr "\0" "\n" < /proc/"$pid"/cmdline 2>/dev/null)
else
  args=$(ps -o args= -p "$pid" 2>/dev/null | tr ' ' '\n')
fi
printf '%s\n' "$args" | grep -qx app-server && exit 1

if [ -r /proc/"$pid"/environ ]; then
  pane=$(tr "\0" "\n" < /proc/"$pid"/environ 2>/dev/null | sed -n "s/^HERDR_PANE_ID=//p")
else
  # macOS has no /proc; `ps eww` appends the environment of a process of this user.
  pane=$(ps eww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n' | sed -n "s/^HERDR_PANE_ID=//p" | head -1)
fi
[ -n "$pane" ] || exit 1

herdr=$(command -v herdr 2>/dev/null)
for c in "$HOME/.local/bin/herdr" /opt/homebrew/bin/herdr /usr/local/bin/herdr "$HOME/.cargo/bin/herdr"; do
  [ -n "$herdr" ] && break
  [ -x "$c" ] && herdr=$c
done
[ -n "$herdr" ] || exit 1

# Nothing is sent unless herdr says what the pane is and what it is doing, and the
# screen shows its input box: a poke presses Enter on whatever is in that box. When
# herdr cannot be read now, exit 75 (EX_TEMPFAIL) and the board tries again on a
# later tick, until the target is idle or has read its mail.
info=$("$herdr" agent get "$pane" 2>/dev/null) || exit 75
status=$(printf '%s' "$info" | sed -n 's/.*"agent_status":"\([a-z_]*\)".*/\1/p')
agent=$(printf '%s' "$info" | grep -o '"agent":"[a-z]*"' | head -n 1 | sed 's/.*:"\(.*\)"/\1/')

# A working agent collects its mail at its own Stop, and a prompt would type into its
# turn; a blocked one has a dialog open. Only idle or done takes a prompt.
case "$status" in
  idle|done) ;;
  *) exit 75 ;;
esac

# A poke presses Enter on whatever is in the input box, so it goes only to a box
# this can prove is empty. Each agent frames its box in a way the screen shows:
#   Claude  a ─── rule above and below, from the first column; the first row
#           inside starts with ❯, and continuation rows are indented.
#   Codex   a block of rows on a background colour (SGR 48), a blank row at its
#           top and bottom, the › row below the top one, and the footer below.
# Empty is the glyph and the agent's dim placeholder (SGR 2) on the first row, and
# nothing on any other row. Anything else, or a box this cannot frame, is 75.
case "$agent" in
  claude) glyph='❯' ;;
  codex)  glyph='›' ;;
  *) exit 1 ;;
esac
esc=$(printf '\033')
screen=$("$herdr" agent read "$pane" --source visible --format ansi 2>/dev/null) || exit 75
printf '%s\n' "$screen" | LC_ALL=C awk -v g="$glyph" -v agent="$agent" -v e="$esc" \
    -v rule='─' -v nbsp="$(printf '\302\240')" '
  function plain(s) { gsub(e "\\[[0-9;?]*[A-Za-z]", "", s); return s }
  function undim(s) { gsub(e "\\[2m(" e "\\[[0-9;]*m)*[^" e "]*", "", s); return s }
  function blank(s) { gsub(/[ \t\r]/, "", s); gsub(nbsp, "", s); return s == "" }
  # A rule starts in the first column with at least 20 of ─ and ends with one; it
  # may carry the session name in it. Draft rows are indented, so text with ─ in
  # it is never one.
  function isrule(s,   c) {
    sub(/[ \t\r]+$/, "", s)
    if (substr(s, length(s) - length(rule) + 1) != rule) return 0
    for (c = 0; c < 20 && substr(s, 1, length(rule)) == rule; c++) s = substr(s, length(rule) + 1)
    return c == 20
  }
  function bg(s) { return index(s, e "[48;") > 0 }
  { raw[NR] = $0; p[NR] = plain($0) }
  END {
    if (agent == "claude") {
      for (n = NR; n >= 1; n--) if (isrule(p[n])) { if (!r2) r2 = n; else { r1 = n; break } }
      if (!r1 || r2 - r1 < 2) exit 3
      top = r1 + 1; bot = r2 - 1
    } else {
      for (n = NR; n >= 1 && !bg(raw[n]); n--) ;
      if (n < 1 || n == NR) exit 3
      bot = n
      for (top = n; top > 1 && bg(raw[top - 1]); top--) ;
      if (bot - top < 2 || !blank(p[top]) || !blank(p[bot])) exit 3
      top++; bot--
    }
    if (index(p[top], g) != 1) exit 3
    first = plain(undim(raw[top]))
    if (index(first, g) == 1) first = substr(first, length(g) + 1)
    if (!blank(first)) exit 4
    for (n = top + 1; n <= bot; n++) if (!blank(p[n])) exit 4
  }' || exit 75

exec "$herdr" agent prompt "$pane" "you have mail, run agentboard inbox" >/dev/null
